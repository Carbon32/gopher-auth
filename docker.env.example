# Well, this is an example of how the file should look like

# Don't forget the migrations:
# docker exec <the name you're using> /migrate up

# And if Bash goes crazy on Windows, use the line below
# MSYS_NO_PATHCONV=1 docker exec <the name you're using> /migrate up

# You can also run the migrations in your source folder, the database is host-based

DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=carbon123
DB_NAME=go_backend
DB_SSLMODE=disable

JWT_SECRET=whateverman

SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM=noreply@localhost

PUBLIC_APP_URL=http://localhost:5173

HTTP_ADDR=:8080
TLS_CERT_FILE=
TLS_KEY_FILE=
CORS_ALLOWED_ORIGINS=http://localhost:5173
